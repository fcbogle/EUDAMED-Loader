## Legacy Dev configuration; new installations should use .env.dev.example.
## Select the environment at startup, not by editing this file.
EUDAMED_MESSAGE_SCHEMA_VERSION=3.0.32
EUDAMED_SCHEMA_DIR=data/schema_profiles/dev-3.0.32-derived
EUDAMED_MANUFACTURER_SRN_OVERRIDE=
EUDAMED_AUTHORISED_REPRESENTATIVE_SRN_OVERRIDE=
EUDAMED_SUPPRESS_AUTHORISED_REPRESENTATIVE=false
EUDAMED_MAX_BATCH_RECORDS=300
EUDAMED_POST_SERVICE_ID=DEVICE
EUDAMED_PATCH_SERVICE_ID=UDI_DI
EUDAMED_POST_PROFILE=device_post
EUDAMED_PATCH_PROFILE=udidi_patch
