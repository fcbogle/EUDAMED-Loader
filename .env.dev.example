# Select with: python -m app.run --environment dev
EUDAMED_ENVIRONMENT=dev
EUDAMED_MESSAGE_SCHEMA_VERSION=3.0.32
EUDAMED_SCHEMA_DIR=data/schema_profiles/dev-3.0.32-derived
EUDAMED_EXCEL_DIR=data/source_excel
EUDAMED_BASIC_UDI_REFERENCE_DIR=data/basic_udi_reference
EUDAMED_TESTING_STATE_DB_PATH=data/testing/testing-state.sqlite3
EUDAMED_TESTING_STATE_BACKUP_DIR=data/testing/backups
EUDAMED_NORMALIZATION_DIR=config/normalization
EUDAMED_REPORTS_DIR=docs/reports
EUDAMED_ARTIFACTS_DIR=data/dev/artifacts
# Copy approved existing Dev values from .env; do not lose working actor settings.
EUDAMED_MANUFACTURER_SRN_OVERRIDE=
EUDAMED_AUTHORISED_REPRESENTATIVE_SRN_OVERRIDE=
EUDAMED_SUPPRESS_AUTHORISED_REPRESENTATIVE=false
EUDAMED_MAX_BATCH_RECORDS=300
